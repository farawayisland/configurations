# ~/.config/zsh/functions/interactive/git_review_counting_from_head

# Dependencies
## git | https://formulae.brew.sh/formula/git

# Definition
if [[ $# -eq 0 ]] ; then
  printf '%s\n' 'No argument supplied' >&2
  return 1
fi

printf '─%.0s' $(seq 1 $(tput cols))
printf '\n'

local count_from_head="$@[-1]"
local commit="HEAD~$count_from_head"
local parent="HEAD~$(($count_from_head + 1))"

git diff "${@[1,-2]}" "$parent" "$commit"

printf '─%.0s' $(seq 1 $(tput cols))
printf '\n'

git diff --stat "$parent" "$commit"

printf '─%.0s' $(seq 1 $(tput cols))
printf '\n'
print -Pn '%F{green}'

git log --pretty=%B "$parent".."$commit" | head -n -1

print -Pn '%F{reset}'
printf '─%.0s' $(seq 1 $(tput cols))
printf '\n'
